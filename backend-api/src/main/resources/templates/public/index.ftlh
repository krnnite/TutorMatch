<#assign pageTitle="TutorMatch - Match with Local Experts in Your Desired Field!">
    <#include "/public/index-layout.ftlh">
        <main id="main-content" class="overflow-hidden">
            <div class="tutormatch-hero overlay py-5">
                <div class="container text-center">
                    <div class="row align-items-center justify-content-center">
                        <div class="col-lg-8 mx-auto">
                            <h1 class="mb-4 heading hero-heading fw-bold">Learning Hub for Students of All Ages</h1>
                            <div class="mb-5 description hero-description fs-5">
                                <p>
                                    An inclusive, vibrant online learning community where you can learn just about anything you can think of.
                                    <a class="link-warning text-decoration-underline" href="#">Meet our tutors</a>
                                    and explore all that you can learn here.
                                </p>
                            </div>
                            <div class="hero-cta">
                                <a class="btn btn-primary btn-lg px-5 py-3 shadow" href="#">Explore Now</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <footer class="site-footer py-4">
            <div class="container">
                <div class="row">
                    <div class="col-lg-3 me-auto">
                        <div class="widget">
                            <h3>About TutorMatch</h3>
                            <p>
                                Lorem ipsum dolor sit, amet consectetur adipisicing elit. Odio ad magni possimus eaque suscipit consequuntur exercitationem explicabo voluptas, quo deserunt iure, vero nemo debitis deleniti at nihil? Quaerat quas nemo porro, ipsam laboriosam pariatur.
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-2 ms-auto">
                        <div class="widget">
                            <h3>Have any Questions?</h3>
                            <ul>
                                <li></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="widget">
                            <h3>Gallery</h3>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="widget">
                            <h3>Contact</h3>
                            <address>48 Splendor Ave. Galileo, New Gineau 58964</address>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    </body>
</html>